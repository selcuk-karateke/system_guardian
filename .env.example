# === Deploy / Runtime (bleibt in ENV) ===

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/system_guardian

# Check execution: mock (Windows dev) | ssh (production)
CHECK_MODE=mock

# Cron protection
CRON_SECRET=change-me-to-random-string

# Dashboard login (production: set all three — ohne diese Vars bleibt UI lokal offen)
# AUTH_SECRET also encrypts SSH/Coolify/Notify secrets in DB (min. 16 chars)
AUTH_SECRET=change-me-long-random-string
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-strong-password
# Mehrere User: admin:pass1,max:pass2
# AUTH_USERS=
# 2FA (TOTP QR) + DB-User/Rollen: Einstellungen → Sicherheit / Benutzer
# Rollen: admin | operator | viewer

# Read-only API for bot / integrations (Bearer token)
API_SECRET=change-me-api-token

# App URL (for links in emails)
APP_URL=http://localhost:3000

# Zeitzone für Alerts/Berichte
APP_TIMEZONE=Europe/Berlin

# === App-Config liegt in der DB (Einstellungen-UI) ===
# SSH / Coolify / Backup → Einstellungen → Server
# Telegram / Discord / SMTP → Einstellungen → Benachrichtigungen
# Schwellen / Trusted IPs → Einstellungen → Schwellen & Trusted IPs
#
# Optional one-time seed (nur wenn settings-Zeile noch fehlt):
# THRESHOLD_CPU_WARNING=80
# TRUSTED_LOGIN_IPS=1.2.3.4
# BACKUP_MAX_AGE_DAYS=7

# === Optional one-time seed for Allowlists (Settings UI is source of truth) ===
# Only applied if settings key runtime.allowlists is still missing:
# EXPECTED_STOPPED_CONTAINERS=nextcloud-aio-mastercontainer
# EXPECTED_FAILED_UNITS=chkrootkit.service
# FIM_PATHS=/etc/passwd,/etc/ssh/sshd_config,/etc/sudoers,/root/.ssh/authorized_keys
# KNOWN_PORTS=22,80,443,3000,5432,6379,8000,8080
# KNOWN_DOCKER_IMAGE_PREFIXES=coolifyio/,ghcr.io/coolify,traefik:,postgres:,redis:,mysql:,mariadb:,nginx:,alpine:
# INCIDENT_IOC_DOMAINS=xlgelllulyrhpbjmn.org,yxmvknylyxtt.org
# BLOCKED_REMOTE_IPS=216.218.185.162
# AUTO_BLOCK_ENABLED=true
# AUTO_BLOCK_JAIL=sshd
# TRUSTED_OUTBOUND_PROCESSES=my-extra-process
# TRUSTED_SHELL_PROCESS_PATTERNS=my-custom-start-script

# Trivy (still ENV)
# TRIVY_CRON_ENABLED=false
# TRIVY_SCAN_LIMIT=8
# TRIVY_MAX_AGE_DAYS=7

# Beobachtungsfenster für Log-Grep in security_posture (Stunden)
OBSERVATION_HOURS=24

# Software-RAID (mdadm) – false wenn kein md-RAID
RAID_CHECK_ENABLED=true

# TV monitor (/monitor)
# MONITOR_NIGHT_MODE=false
# MONITOR_NIGHT_START=22
# MONITOR_NIGHT_END=7
# MONITOR_PIXEL_SHIFT_SEC=180
