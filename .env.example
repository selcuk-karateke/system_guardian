# Database
DATABASE_URL=postgresql://user:password@localhost:5432/system_guardian

# Check execution: mock (Windows dev) | ssh (production)
CHECK_MODE=mock

# SSH target (production)
SSH_HOST=your-server.example.com
SSH_USER=root
SSH_PORT=22
# Inline key (use \n for newlines) OR path:
SSH_PRIVATE_KEY=
# SSH_PRIVATE_KEY_PATH=/run/secrets/ssh_key

# Cron protection
CRON_SECRET=change-me-to-random-string

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=system-guardian@example.com
SMTP_TO=ops@example.com

# Thresholds (optional overrides)
THRESHOLD_CPU_WARNING=80
THRESHOLD_CPU_CRITICAL=95
THRESHOLD_RAM_WARNING=85
THRESHOLD_RAM_CRITICAL=95
THRESHOLD_DISK_WARNING=85
THRESHOLD_DISK_CRITICAL=95

# Backup paths on remote host (comma-separated)
BACKUP_PATHS=/var/backups/postgres,/var/backups/docker,/var/backups/coolify

# App URL (for links in emails)
APP_URL=http://localhost:3000
