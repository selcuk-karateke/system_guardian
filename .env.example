# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/system_guardian

# Check execution: mock (Windows dev) | ssh (production)
CHECK_MODE=mock

# SSH target (production)
SSH_HOST=your-server.example.com
SSH_USER=root
SSH_PORT=22
# Windows: Key als Datei (empfohlen) – siehe secrets/README
SSH_PRIVATE_KEY_PATH=./secrets/id_ed25519
# Inline key (eine Zeile mit \n) – Mehrzeilen in .env funktionieren oft NICHT:
# SSH_PRIVATE_KEY=
# Wenn ssh -i key … trotzdem nach Passwort fragt: Public Key fehlt auf dem Server.
# Bis dahin (nur lokal, nicht committen):
# SSH_PASSWORD=dein-root-passwort

# Cron protection
CRON_SECRET=change-me-to-random-string

# Dashboard login (Coolify: set all three — ohne diese Vars bleibt UI lokal offen)
AUTH_SECRET=change-me-long-random-string
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-strong-password
# Mehrere User: admin:pass1,max:pass2
# AUTH_USERS=

# Read-only API for bot / integrations (Bearer token)
API_SECRET=change-me-api-token

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord (Server → Kanal → Integrationen → Webhooks)
DISCORD_WEBHOOK_URL=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=system-guardian@example.com
SMTP_TO=ops@example.com

# Thresholds (optional overrides)
THRESHOLD_CPU_WARNING=80
THRESHOLD_CPU_CRITICAL=95
THRESHOLD_RAM_WARNING=85
THRESHOLD_RAM_CRITICAL=95
THRESHOLD_DISK_WARNING=85
THRESHOLD_DISK_CRITICAL=95
# Suspicious activity: process CPU % and docker stats (single snapshot)
THRESHOLD_PROCESS_CPU_WARNING=90
THRESHOLD_DOCKER_CPU_WARNING=85
THRESHOLD_DOCKER_MEM_WARNING=90

# Backup paths on remote host (comma-separated dirs, files, or globs)
# Backup paths on SSH host (comma-separated). Daily rsync: use …/daily (folder mtime).
# NAS copy is separate — not checked unless that host is SSH target.
BACKUP_PATHS=/backups/daily,/backups/monthly,/data/coolify/backups
# Critical if newest backup across all paths is older than N days; warning if smaller than bytes
BACKUP_MAX_AGE_DAYS=7
BACKUP_MIN_SIZE_WARNING_BYTES=10485760
# Optional: absolute path on SSH host to start backup (Settings → Schutz). Empty = off.
# BACKUP_TRIGGER_COMMAND=/usr/local/bin/run-backup.sh

# Protect: auto-ban only IPs already in BLOCKED_REMOTE_IPS (default off)
# AUTO_BLOCK_ENABLED=true
# AUTO_BLOCK_JAIL=sshd

# Known admin/VPN IPs — no logins warning for root/failed auth from these
TRUSTED_LOGIN_IPS=95.90.232.165,188.194.38.185,77.64.147.213,10.0.1.27,10.0.1.9,10.0.1.23
# Logins: 10.0.1.* intern immer vertrauenswürdig (wie Outbound)
# Outbound ss peers (merged with TRUSTED_LOGIN_IPS; 10.0.1.* always allowed)
# TRUSTED_OUTBOUND_IPS=10.0.1.24
# Outbound :80/:443 Prozesse ohne Warning (Defaults inkl. hermes, traefik, nginx, …)
# TRUSTED_OUTBOUND_PROCESSES=my-extra-process
# security_posture: extra regex for benign `sh -c` in ps aux (comma-separated)
# TRUSTED_SHELL_PROCESS_PATTERNS=my-custom-start-script

# Stopped containers matching these names are expected (substring match)
EXPECTED_STOPPED_CONTAINERS=nextcloud-aio-mastercontainer

# systemd failed units that are benign (comma-separated; default: chkrootkit without mail)
EXPECTED_FAILED_UNITS=chkrootkit.service

# File Integrity Monitoring (FIM) – comma-separated paths on SSH host
FIM_PATHS=/etc/passwd,/etc/ssh/sshd_config,/etc/sudoers,/root/.ssh/authorized_keys

# Ports that do not trigger "new port" warnings (comma-separated)
KNOWN_PORTS=22,80,443,3000,5432,6379,8000,8080

# Docker: trusted image prefixes; new containers outside → CRITICAL
# KNOWN_DOCKER_IMAGE_PREFIXES=coolifyio/,ghcr.io/coolify,traefik:,postgres:,redis:,mysql:,mariadb:,nginx:,alpine:

# Trivy (Security-Cron): HIGH/CRITICAL → Alerts. Batch klein halten (langsam).
# TRIVY_CRON_ENABLED=false
# TRIVY_SCAN_LIMIT=8
# TRIVY_MAX_AGE_DAYS=7

# IOC / blocklist (laufend, ss + Logs)
INCIDENT_IOC_DOMAINS=xlgelllulyrhpbjmn.org,yxmvknylyxtt.org
BLOCKED_REMOTE_IPS=216.218.185.162

# Beobachtungsfenster für Log-Grep in security_posture (rollierend, Stunden)
OBSERVATION_HOURS=24

# Zeitzone für Alerts/Berichte (Dashboard + Export)
APP_TIMEZONE=Europe/Berlin
# Nur für festes BSI-/Incident-Fenster: INCIDENT_USE_FIXED_WINDOW=true
# INCIDENT_LOG_SINCE=2026-06-02T07:15:00
# INCIDENT_LOG_UNTIL=2026-06-02T07:45:00

# Software-RAID (mdadm) prüfen via /proc/mdstat – false wenn du kein md-RAID hast
RAID_CHECK_ENABLED=true

# App URL (for links in emails)
APP_URL=http://localhost:3000

# TV monitor (/monitor) — burn-in protection (browser local time)
# MONITOR_NIGHT_MODE=false
# MONITOR_NIGHT_START=22
# MONITOR_NIGHT_END=7
# MONITOR_PIXEL_SHIFT_SEC=180
